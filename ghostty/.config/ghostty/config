# Ctrl+B Prefix Keybindings:
#   h/j/k/l    Navigate splits
#   d          New split (down)
#   s          New split (right)
#   x          Close pane
#   c          New tab
#   n/p        Next/prev tab
#   t          Rename tab (prompt)
#   1-9        Go to tab N
#   Ctrl+h/j/k/l  Resize splits
#   r          Reload config
#   z          Command palette

# unbindings
keybind = super+d=unbind
keybind = super+shift+D=unbind
keybind = super+alt+shift+h=unbind
keybind = super+w=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+i=unbind

# prefix: ctrl+b
# navigate splits (vim-style)
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:down
keybind = ctrl+b>k=goto_split:up
keybind = ctrl+b>l=goto_split:right

# create splits
keybind = ctrl+b>d=new_split:down
keybind = ctrl+b>s=new_split:right

# close pane
keybind = ctrl+b>x=close_surface

# resize splits (ctrl+b>ctrl+h/j/k/l)
keybind = ctrl+b>ctrl+h=resize_split:left,20
keybind = ctrl+b>ctrl+j=resize_split:down,20
keybind = ctrl+b>ctrl+k=resize_split:up,20
keybind = ctrl+b>ctrl+l=resize_split:right,20

# tabs
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab
keybind = ctrl+b>t=prompt_tab_title
keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3
keybind = ctrl+b>4=goto_tab:4
keybind = ctrl+b>5=goto_tab:5
keybind = ctrl+b>6=goto_tab:6
keybind = ctrl+b>7=goto_tab:7
keybind = ctrl+b>8=goto_tab:8
keybind = ctrl+b>9=goto_tab:9

# config
keybind = ctrl+b>r=reload_config
keybind = ctrl+b>z=toggle_command_palette

# legacy alt shortcuts (kept for quick access)
keybind = alt+d=new_split:down
keybind = alt+shift+d=new_split:right
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_right=goto_split:right
keybind = super+arrow_left=resize_split:left,20
keybind = super+arrow_down=resize_split:down,20
keybind = super+arrow_up=resize_split:up,20
keybind = super+arrow_right=resize_split:right,20
keybind = super+w=close_surface
keybind = super+alt+r=reload_config
keybind = super+alt+o=open_config

font-family=""
font-family = CaskaydiaCove Nerd Font Mono
font-feature = calt, liga, dlig
font-size = 18
adjust-cell-height = 2

background-blur = 5
background-opacity = 0.9
unfocused-split-opacity=0.7
clipboard-read = allow
clipboard-write = allow
maximize = true
mouse-hide-while-typing = true
shell-integration = zsh
window-height = 72
window-new-tab-position = end
window-save-state = always
window-subtitle = working-directory
window-theme = dark
window-width = 218
working-directory = ~/wsp

theme = TokyoNight
background = #1a1b26
foreground = #c0caf5
selection-background = #33467c
selection-foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #15161e
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

keybind = shift+enter=text:\x1b\r
