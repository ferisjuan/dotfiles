{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agent": {
    "orchestrator": {
      "description": "Orchestrator - coordinates dev-huddle, develop, review, test workflow",
      "mode": "primary",
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.1
    },
    "archivist": {
      "description": "Archivist - manages AI memory, ADRs, and knowledge graph across sessions",
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.1
    },
    "dev-huddle": {
      "description": "Create execution plan from Jira ticket and initialize ADR",
      "mode": "subagent",
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.6
    },
    "develop": {
      "description": "Implement plan with human-in-the-loop approval and report commits for ADR tracking",
      "mode": "subagent",
      "model": "minimax-coding-plan/MiniMax-M2.7-highspeed",
      "temperature": 0.1
    },
    "discovery": {
      "description": "Discuss next features, create tickets",
      "mode": "subagent",
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.6
    },
    "documenter": {
      "description": "Documenter - documents functions and components without modifying code",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "temperature": 0.1
    },
    "review": {
      "description": "Review code for quality, best practices, SOLID, YAGNI, DRY, scalability and separation of concerns for Next.js + TanStack Stack (React) + NodeJS backend",
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.1
    },
    "test": {
      "description": "Run tests on implemented code",
      "mode": "subagent",
      "model": "minimax-coding-plan/MiniMax-M2.7-highspeed",
      "temperature": 0.1
    }
  },
  "mcp": {
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "oauth": {}
    },
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "oauth": {}
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "oauth": {}
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "oauth": {}
    },
    "crome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    }
  },
  "provider": {
    "local-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-no-key-required"
      },
      "models": {
        "/Users/juan/.lmstudio/models/barozp/Qwen3.6-28B-REAP20-A3B-GGUF/Qwen3.6-28B-REAP20-A3B-Q3_K_S.gguf": {
          "name": "Qwen3.6-28B-REAP20-A3B-GGUF (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-3n-e4b": {
          "name": "google/gemma-4-e4b"
        }
      }
    }
  }
}
